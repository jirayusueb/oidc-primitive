{
	"alias": "oidc-primitive",
	"description": "examples/bun-op built on oidc-primitive",
	"server": {
		"discoveryUrl": "https://op.test/.well-known/openid-configuration"
	},
	"client": {
		"client_id": "conformance-1",
		"client_secret": "${SECRET_1}"
	},
	"client2": {
		"client_id": "conformance-2",
		"client_secret": "${SECRET_2}"
	},
	"client_secret_post": {
		"client_id": "conformance-3",
		"client_secret": "${SECRET_3}"
	},
	"browser": [
		{
			"match": "https://op.test/authorize*",
			"tasks": [
				{
					"task": "Login",
					"optional": true,
					"match": "https://op.test/login*",
					"commands": [
						["text", "id", "username", "conformance"],
						["click", "id", "submit"]
					]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/callback*",
					"commands": [["wait", "id", "submission_complete", 10]]
				}
			]
		}
	],
	"override": {
		"oidcc-prompt-login": {
			"browser": [
				{
					"comment": "second authorization shows the login page again",
					"match": "https://op.test/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "https://op.test/login*",
							"commands": [
								["wait", "xpath", "//*", 10, "Sign in", "update-image-placeholder-optional"],
								["text", "id", "username", "conformance"],
								["click", "id", "submit"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				}
			]
		},
		"oidcc-max-age-1": {
			"browser": [
				{
					"comment": "second authorization shows the login page again",
					"match": "https://op.test/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "https://op.test/login*",
							"commands": [
								["wait", "xpath", "//*", 10, "Sign in", "update-image-placeholder-optional"],
								["text", "id", "username", "conformance"],
								["click", "id", "submit"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				}
			]
		},
		"oidcc-ensure-registered-redirect-uri": {
			"browser": [
				{
					"comment": "unregistered redirect URI shows the error page",
					"match": "https://op.test/authorize*",
					"tasks": [
						{
							"task": "Expect the error page",
							"match": "https://op.test/authorize*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"Invalid authorization request",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		},
		"oidcc-ensure-request-object-with-redirect-uri": {
			"browser": [
				{
					"comment": "unsupported request object with a bad redirect URI shows the error page",
					"match": "https://op.test/authorize*",
					"tasks": [
						{
							"task": "Expect the error page",
							"match": "https://op.test/authorize*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"Invalid authorization request",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		}
	}
}
