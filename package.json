{
	"name": "oidc-primitive-monorepo",
	"private": true,
	"homepage": "https://github.com/jirayusueb/oidc-primitive#readme",
	"bugs": {
		"url": "https://github.com/jirayusueb/oidc-primitive/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jirayusueb/oidc-primitive.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"examples/*",
		"conformance"
	],
	"type": "module",
	"scripts": {
		"build": "bunup",
		"check-dts": "bun scripts/check-dts.ts",
		"conformance": "bun run --filter conformance run",
		"dev": "bunup --watch",
		"docs:dev": "bun run --filter docs dev",
		"docs:build": "bun run --filter docs build",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp -r --commit --push --tag",
		"test": "bun test",
		"test:node": "vitest run",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "bun run --filter '*' type-check"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/node": "^26.6.6",
		"bumpp": "^12.2.2",
		"bunup": "^0.16.32",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^7.0.2"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	}
}
